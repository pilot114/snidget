{
    "name": "pilot114/snidget",
    "description": "snidget framework",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.6",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "psr/log": "*",
        "psr/simple-cache": "^3.0",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "phpstan/phpstan": "^2.3.7",
        "rector/rector": "^2.8.5",
        "phpunit/phpunit": "^13.4.8",
        "league/commonmark": "^2.10.7",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-strict-rules": "^2.1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "scripts": {
        "hook-install": "git config core.hooksPath dev/git-hooks",
        "test": "XDEBUG_MODE=coverage phpunit dev/tests --coverage-html dev/tests/coverage --coverage-filter src --order-by random --bootstrap dev/tests/bootstrap.php",
        "fix": [
            "rector process --config dev/rector.php",
            "phpcbf --standard=dev/phpcs.xml"
        ],
        "check": [
            "phpstan analyse -c dev/phpstan.neon --memory-limit=1G --no-progress",
            "rector process --config dev/rector.php --dry-run",
            "phpcs --standard=dev/phpcs.xml"
        ]
    },
    "autoload": {
        "psr-4": {
            "Snidget\\": "src",
            "App\\": "App"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
