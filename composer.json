{
    "name": "pilot114/snidget",
    "description": "snidget framework",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "psr/log": "*",
        "psr/simple-cache": "^3.0",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.7",
        "phpunit/phpunit": "^13.4",
        "league/commonmark": "^2.10",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "scripts": {
        "hook-install": "git config core.hooksPath utils/git-hooks",
        "test": "XDEBUG_MODE=coverage phpunit utils/tests --coverage-html utils/tests/coverage --coverage-filter src --order-by random --bootstrap utils/tests/bootstrap.php",
        "fix": [
            "rector process",
            "phpcbf"
        ],
        "check": [
            "phpstan analyse --memory-limit=1G --no-progress",
            "rector process --dry-run",
            "phpcs"
        ]
    },
    "autoload": {
        "psr-4": {
            "Snidget\\": "src",
            "App\\": "App"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
