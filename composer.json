{
    "name": "pilot114/snidget",
    "description": "snidget framework",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "psr/log": "*",
        "psr/simple-cache": "^3.0",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.7",
        "phpunit/phpunit": "^13.4",
        "league/commonmark": "^2.10"
    },
    "scripts": {
        "hook-install": "git config core.hooksPath utils/git-hooks",
        "test": "XDEBUG_MODE=coverage phpunit utils/tests --coverage-html utils/tests/coverage --coverage-filter src --order-by random --bootstrap utils/tests/bootstrap.php",
        "phpstan": "phpstan analyse -c utils/phpstan.neon --memory-limit 256M",
        "lint": "rector process --dry-run --config utils/rector.php",
        "fix": "rector process --config utils/rector.php"
    },
    "autoload": {
        "psr-4": {
            "Snidget\\": "src",
            "App\\": "App"
        },
        "files": [
            "src/functions.php"
        ]
    }
}
