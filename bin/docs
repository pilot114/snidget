#!/usr/local/bin/php
<?php

use League\CommonMark\CommonMarkConverter;

include_once '/app/vendor/autoload.php';

$converter = new CommonMarkConverter([
    'html_input' => 'allow',
    'allow_unsafe_links' => false,
]);

// file => [title, overview, menu group]
$pages = [
    'intro'      => ['Концепция', 'Для чего нужен этот фреймворк', 'part'],
    'base'       => ['Основы', 'Базовые понятия', 'part'],
    'http'       => ['HTTP', 'Роутинг, контроллеры, посредники', 'part'],
    'cli'        => ['CLI', 'Консольные команды', 'part'],
    'database'   => ['Базы данных', 'Работа с персистентными данными', 'part'],
    'extra'      => ['Расширение функционала', 'PSR, события, модули, инфраструктура', 'part'],
    'front'      => ['Фронт', 'Немного о уровне представления', 'part'],
    'psr'        => ['PSR имплементации', '', 'addition'],
    'attributes' => ['Список атрибутов', '', 'addition'],
    'events'     => ['Список событий', '', 'addition'],
    'admin'      => ['Admin', '', 'module'],
    // async.md is an article in progress, not shown yet
    'async-module' => ['Async', '', 'module'],
];

$html = ['%part%' => '', '%addition%' => '', '%module%' => '', '%pages%' => ''];
foreach ($pages as $file => [$title, $overview, $group]) {
    $path = "/app/dev/docs/md/$file.md";
    // a section that is not written yet is not shown
    if (!is_file($path)) {
        continue;
    }

    $html["%$group%"] .= "<a href=\"#$file\"><b>$title</b><small>$overview</small></a>\n";
    $html['%pages%'] .= "<section id=\"$file\" class=\"page\">\n" . $converter->convert(file_get_contents($path)) . "</section>\n";
}

$template = file_get_contents('/app/dev/docs/index.template.html');
file_put_contents('/app/dev/docs/index.html', strtr($template, $html));
